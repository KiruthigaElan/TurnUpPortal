<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- IMPORTANT: enables Reqnroll feature generation -->
		<GenerateReqnrollCodeBehindFiles>true</GenerateReqnrollCodeBehindFiles>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="NUnit" Version="4.4.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="5.1.0" />
		<PackageReference Include="Reqnroll" Version="3.3.3" />
		<PackageReference Include="Reqnroll.NUnit" Version="3.3.3" />
		<PackageReference Include="Reqnroll.Tools.MsBuild.Generation" Version="3.3.3" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Drivers\" />
		<Folder Include="Support\" />
	</ItemGroup>

</Project>